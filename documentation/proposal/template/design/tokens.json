{
  "$schema": "church-auditorium-proposal/tokens/1.0",
  "color": {
    "ink":        { "value": "#1E1E1C", "use": "Primary text, technical headings, rules, cut elements" },
    "paper":      { "value": "#F5F2EC", "use": "Report page background" },
    "drawing":    { "value": "#FFFFFF", "use": "Drawing sheets and drawing grounds" },
    "slate":      { "value": "#5B636B", "use": "Supporting text, labels, table headers (5.9:1 on paper)" },
    "slateLight": { "value": "#8E959C", "use": "Placeholder values, secondary rules" },
    "rule":       { "value": "#D5D2CA", "use": "Hairline row rules, header/footer rules" },
    "zebra":      { "value": "#EEEBE4", "use": "Alternate table rows" },
    "bronze":     { "value": "#8C5E36", "use": "Accent: section numbers, figure/table numbers, callouts (5.2:1 on paper)" },
    "oxide":      { "value": "#8A3324", "use": "Critical severity, unverified status only" },
    "cover":      { "value": "#1F2022", "use": "Cover ground" },
    "opener":     { "value": "#2A2C2F", "use": "Chapter opener ground" },
    "drawingInk": { "ink": "#1D1D1B", "grey": "#6E747B", "mid": "#9AA1A8", "light": "#C8CCD0", "tone": "#E7E5DF", "accent": "#9A6A3F" }
  },
  "font": {
    "display": { "family": "Newsreader", "file": "fonts/Newsreader-300.woff2", "axes": "wght 300–500, opsz 6–72", "licence": "SIL OFL" },
    "body":    { "family": "Archivo", "file": "fonts/Archivo-400.woff2", "axes": "wght 400–600", "licence": "SIL OFL" },
    "mono":    { "family": "IBM Plex Mono", "files": ["fonts/IBMPlexMono-400.woff2", "fonts/IBMPlexMono-500.woff2"], "licence": "SIL OFL" }
  },
  "type": {
    "coverTitle":  { "font": "display", "size": "31pt", "lineHeight": 1.04, "weight": 300 },
    "openerNumber":{ "font": "display", "size": "120pt", "lineHeight": 0.8, "weight": 300, "color": "#B98A5C" },
    "h1":          { "font": "display", "size": "27pt", "lineHeight": 1.04, "weight": 400, "tracking": "-0.01em", "note": "22–24pt on dense pages" },
    "lead":        { "font": "display", "size": "13pt", "lineHeight": 1.42, "weight": 400 },
    "statement":   { "font": "display", "size": "10–10.5pt", "lineHeight": 1.42 },
    "body":        { "font": "body", "size": "8.6pt", "lineHeight": 1.55, "weight": 400 },
    "tableHead":   { "font": "body", "size": "7.6–8.5pt", "weight": 500 },
    "tableCell":   { "font": "body", "size": "6.2–7.2pt", "lineHeight": 1.3, "numerals": "tabular" },
    "colHeader":   { "font": "mono", "size": "5.2–5.4pt", "weight": 500, "tracking": "0.04em", "case": "upper" },
    "label":       { "font": "mono", "size": "6.2pt", "weight": 500, "tracking": "0.07em", "case": "upper" },
    "data":        { "font": "mono", "size": "5.6–9pt", "weight": "400/500" },
    "caption":     { "font": "body", "size": "6.2–7pt", "lineHeight": 1.4, "color": "slate" },
    "metric":      { "font": "display", "size": "23pt", "weight": 300, "numerals": "lining tabular" }
  },
  "page": {
    "a4": { "size": "210 × 297 mm", "margin": { "top": "24mm (21–22 dense)", "bottom": "22mm (19–20 dense)", "binding": "25mm", "outer": "15mm" },
            "runningHeader": "9mm from top", "folio": "9mm from foot", "columns": { "rail": "38mm", "gutter": "4mm", "text": "128mm" } },
    "a3Editorial": { "size": "420 × 297 mm landscape", "margin": "15mm", "spreadGutter": "210mm centre line" },
    "a3Sheet": { "size": "420 × 297 mm landscape", "border": "8mm inset, 0.75pt", "titleBlock": "62mm right column", "drawingArea": "≈ 338 × 277 mm" }
  },
  "rule": { "heavy": "0.75pt ink — table and section heads", "hair": "0.35pt rule — rows", "row": "0.3pt rule — dense rows" },
  "drawing": {
    "lineWeight_mm": { "cut": 0.50, "heavy": 0.35, "medium": 0.25, "thin": 0.18, "hair": 0.13 },
    "dash_mm": { "grid": "5 1.2 0.6 1.2", "assumed": "1.4 0.9", "unresolved": "0.4 0.8" },
    "text_mm": { "label": 2.2, "dimension": 1.8, "bubble": 2.6 },
    "gridBubble_mm": { "diameter": 6.4, "drawingsReduced": 4.8 },
    "dimensionUnits": "millimetres, oblique ticks",
    "provenance": { "solid": "model geometry", "dashed": "assumption / reference only", "dotted": "unresolved" }
  },
  "provenanceMarks": { "M": "Measured from model geometry", "P": "Authored model property", "E": "Derived preliminary estimate", "C": "Requires confirmation", "X": "Excluded" },
  "severity": { "Critical": { "color": "oxide", "glyph": "●●●" }, "Major": { "color": "bronze", "glyph": "●●○" }, "Minor": { "color": "slate", "glyph": "●○○" } }
}
